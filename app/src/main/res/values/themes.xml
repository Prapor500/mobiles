<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DriveNext" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/dn_background</item>
        <item name="android:navigationBarColor">@color/dn_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/dn_purple</item>
    </style>

    <style name="Theme.DriveNext.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dn_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_car</item>
        <item name="postSplashScreenTheme">@style/Theme.DriveNext</item>
    </style>
</resources>
